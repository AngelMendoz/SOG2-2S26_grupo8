// Manual 2 · RPA · Lo que hace Odoo con cada fila que cargó el robot
// (Scheduled Action «RPA - Procesar cargas pendientes», 01-Odoo/02_scheduled_action_procesar_cargas.py)
// Generar: dot -Tpng -Gdpi=200 03_procesamiento_odoo.dot -o 03_procesamiento_odoo.png
digraph procesamiento_odoo {
  graph [rankdir=TB, fontname="Segoe UI", nodesep=0.3, ranksep=0.32, pad=0.3,
         label="Odoo · acción planificada «RPA - Procesar cargas pendientes» (cada 1 minuto)", labelloc=t, fontsize=16];
  node  [fontname="Segoe UI", fontsize=10, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#5B6B7A"];
  edge  [fontname="Segoe UI", fontsize=9, color="#5B6B7A"];

  inicio [shape=ellipse, fillcolor="#D9EAD3", label="Se dispara la acción planificada"];
  fin    [shape=ellipse, fillcolor="#D9EAD3", label="Fin de la corrida\n(la siguiente es en 1 minuto)"];
  prep   [label="Preparar: categoría web «Cargados por RPA»\ny almacén de la empresa principal"];

  subgraph cluster_cli {
    label="1 · Clientes (x_rpa_cliente)"; style="rounded,dashed"; color="#4A86C5"; fontsize=11;
    c0 [shape=diamond, label="¿Quedan filas\n«Pendiente»?"];
    c1 [shape=diamond, label="¿Tiene Name y\nCompany Type?"];
    cOm [fillcolor="#FFF2CC", label="Omitido +\ndato que falta"];
    c2 [label="Empresa o persona; país y departamento\n(por código o nombre); Related Company; Tags"];
    c3 [shape=diamond, label="¿Ya existe?\n(Reference → Email → Name)"];
    c4 [label="Actualizar contacto"];
    c5 [label="Crear contacto"];
    c6 [label="Tax ID (NIT) en la empresa\n«dueña» del contacto"];
    cOk [fillcolor="#D9EAD3", label="Procesado + mensaje\n+ ID del contacto"];
    cErr [fillcolor="#F4CCCC", label="Error + motivo"];
  }

  subgraph cluster_pro {
    label="2 · Productos (x_rpa_producto)"; style="rounded,dashed"; color="#8A5BB0"; fontsize=11;
    p0 [shape=diamond, label="¿Quedan filas\n«Pendiente»?"];
    p1 [shape=diamond, label="¿Tiene ID Externo,\nName y Product Type?"];
    pOm [fillcolor="#FFF2CC", label="Omitido +\ndato que falta"];
    p2 [label="Goods = almacenable, Service = servicio;\nprecio, costo, peso, descripciones;\npublicado sí/no y categoría web"];
    p3 [shape=diamond, label="¿Ya existe?\n(ID Externo → Internal Reference)"];
    p3b [label="Código de barras solo si\nningún otro producto lo usa"];
    p4 [label="Actualizar producto"];
    p5 [label="Crear producto y\nregistrar su ID Externo"];
    p6 [shape=diamond, label="¿Trae cantidad y\nes almacenable?"];
    p7 [label="Ajuste de inventario a la\ncantidad a la mano exacta"];
    pOk [fillcolor="#D9EAD3", label="Procesado + mensaje\n+ ID del producto"];
    pErr [fillcolor="#F4CCCC", label="Error + motivo"];
  }

  inicio -> prep -> c0;
  c0 -> c1 [label="sí"];
  c1 -> cOm [label="no"];
  c1 -> c2 [label="sí"];
  c2 -> c3;
  c3 -> c4 [label="sí"];
  c3 -> c5 [label="no"];
  c4 -> c6;
  c5 -> c6;
  c6 -> cOk;
  c2 -> cErr [style=dotted, label="excepción"];
  cOm -> c0;
  cOk -> c0;
  cErr -> c0;

  c0 -> p0 [label="no"];
  p0 -> p1 [label="sí"];
  p1 -> pOm [label="no"];
  p1 -> p2 [label="sí"];
  p2 -> p3 -> p3b;
  p3b -> p4 [label="existe"];
  p3b -> p5 [label="nuevo"];
  p4 -> p6;
  p5 -> p6;
  p6 -> p7 [label="sí"];
  p6 -> pOk [label="no"];
  p7 -> pOk;
  p2 -> pErr [style=dotted, label="excepción"];
  pOm -> p0;
  pOk -> p0;
  pErr -> p0;
  p0 -> fin [label="no"];
}
