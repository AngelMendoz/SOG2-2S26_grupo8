      "id_cliente",
      "edad",
      "genero",
      "venta_total",
      "n_compras"
    ],
    "columnas_compras": [
      "id_compra",
      "id_cliente",
      "fecha_compra",
      "monto_compra",
      "metodo_pago",
      "tiempo",
      "navegador",
      "boletin",
      "vale"
    ],
    "tipos_clientes": {
      "id_cliente": "int64",
      "edad": "int64",
      "genero": "int64",
      "venta_total": "float64",
      "n_compras": "int64"
    },
    "tipos_compras": {
      "id_compra": "int64",
      "id_cliente": "int64",
      "fecha_compra": "datetime64[s]",
      "monto_compra": "float64",
      "metodo_pago": "int64",
      "tiempo": "int64",
      "navegador": "int64",
      "boletin": "boolean",
      "vale": "boolean"
    },
    "fecha_minima": "2021-01-01",
    "fecha_maxima": "2021-12-31"
  },
  "verificacion": {
    "validaciones_superadas": true,
    "estadisticas_contrastadas_con_sql": true
  }
}